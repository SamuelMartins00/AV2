# Banco de dados (MySQL 8.0.16 ou superior)
DATABASE_URL="mysql://root:senha@localhost:3306/logistica_db"
# Banco EXCLUSIVO dos testes de integração: o nome deve terminar em _test
TEST_DATABASE_URL="mysql://root:senha@localhost:3306/logistica_db_test"

# Servidor. Em Docker ou na AWS use HOST=0.0.0.0
PORT=3000
HOST=127.0.0.1

# Autenticação. Gere um segredo forte (veja o README)
JWT_SECRET="defina-uma-chave-longa-e-aleatoria"
JWT_ACCESS_EXPIRES=15m
REFRESH_TTL_MINUTES=30
BCRYPT_COST=10
